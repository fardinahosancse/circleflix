{
  "name": "circleflix",
  "version": "1.0.0",
  "description": "Streaming-style desktop player for the CircleFTP media catalog",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "electron build/make-icons.js",
    "dist": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "ffmpeg-static@5.3.0": true
  },
  "productName": "CircleFlix",
  "author": {
    "name": "S.M.Fardin Ahosan",
    "url": "https://github.com/fardinahosancse"
  },
  "homepage": "https://github.com/fardinahosancse/circleflix",
  "repository": {
    "type": "git",
    "url": "https://github.com/fardinahosancse/circleflix.git"
  },
  "bugs": {
    "url": "https://github.com/fardinahosancse/circleflix/issues"
  },
  "build": {
    "appId": "net.circleflix.app",
    "productName": "CircleFlix",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.*",
      "package.json",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CircleFlix-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CircleFlix-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
